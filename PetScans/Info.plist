<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>PetScans needs camera access to scan product barcodes and ingredient labels on pet food products.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PetScans can analyze ingredient labels from your photo library.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so we can see which ads bring people to PetScans and stop paying for the ones that don't. This never affects your scans or your pet's data.</string>
	<key>PetScansAPIBaseURL</key>
	<string>$(PETSCANS_API_BASE_URL)</string>
	<key>FacebookAppID</key>
	<string>$(META_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(META_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>PetScans</string>
	<key>FacebookAutoLogAppEventsEnabled</key>
	<true/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
	</array>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Both come from the build settings MARKETING_VERSION and
	     CURRENT_PROJECT_VERSION, which are the real source of truth: with
	     GENERATE_INFOPLIST_FILE = YES, Xcode overwrites these two keys from those
	     settings, so a literal value here is silently ignored at build time. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app's only cryptography is HTTPS/TLS via system frameworks, which is
	     exempt. Declaring it here means App Store Connect stops asking on every
	     upload; without it each new build blocks submission until the answer is
	     set by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- A storyboard, not a UILaunchScreen dict: that dict's UIImageName pointed at
	     "AppIcon", an .appiconset, which UIKit cannot resolve as a launch image — so
	     the launch screen rendered as a bare colour fill with no logo or wordmark. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Quicksand.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.petscans.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>petscans</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.facebook.PetScans</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(META_APP_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
