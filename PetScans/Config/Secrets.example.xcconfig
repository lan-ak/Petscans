// Secrets.example.xcconfig — committed template.
//
// Copy this file to Secrets.xcconfig (which is gitignored) and fill in real
// values for a configured build. The app target's build configurations use
// Secrets.xcconfig as their base configuration, and Info.plist reads these via
// $(VAR) substitution.
//
// Meta's App ID and client token are client-side identifiers, not secrets — every
// app shipping the Meta SDK exposes them. Keeping them out of the repo just avoids
// hardcoding this account's values into version control. Leaving them empty keeps
// the Meta SDK inert (AttributionService treats empty/REPLACE- values as
// unconfigured), and an empty API base URL falls back to the constant in
// PetScansAPIClient.

// From developers.facebook.com → Settings → Basic.
META_APP_ID =

// From developers.facebook.com → Settings → Advanced → Client token.
META_CLIENT_TOKEN =

// The Cloudflare Worker base URL (no trailing slash). The `$()` between the
// slashes is REQUIRED: xcconfig treats `//` as a comment, so a bare `https://`
// would truncate the value to `https:`.
PETSCANS_API_BASE_URL = https:/$()/REPLACE-WITH-YOUR-WORKER.workers.dev
